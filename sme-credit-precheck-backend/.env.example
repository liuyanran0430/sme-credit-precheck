# 应用信息
APP_NAME=小微企业授信智能预审系统
API_V1_PREFIX=/api/v1
DEBUG=true

# 数据库连接（MySQL 8.0，请替换用户名与密码）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/sme_credit?charset=utf8mb4

# MySQL 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# 材料上传
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# 前端跨域来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173

# 登录认证（AUTH_SECRET_KEY 请替换为足够长的随机字符串）
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_EXPIRE_MINUTES=480

# 材料分类 LLM（OpenAI 兼容接口，如 DeepSeek / 通义千问 / OpenAI）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# OCR 文本加载
OCR_DPI=200
OCR_MAX_PAGES=10
CLASSIFY_TEXT_MAX_CHARS=6000
